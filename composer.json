{
    "name": "telegram-bot-essentials/affiliates",
    "version": "0.0.1",
    "description": "Affiliate feature built for telegram-bot-essentials/essence",
    "type": "library",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12",
        "telegram-bot-essentials/billing": "0.0.1",
        "telegram-bot-essentials/essence": "0.8.0",
        "telegram-bot-essentials/settings": "0.0.1",
        "telegram-bot-essentials/user-wallet": "0.0.1"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "TelegramBotEssentials\\Affiliates\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "authors": [
        {
            "name": "Elyar",
            "email": "elyareranjbar@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Elyar0/telegram-bot-essentials"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Elyar0/tbe-billing"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Elyar0/tbe-settings"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Elyar0/tbe-user-wallet"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "TelegramBotEssentials\\Affiliates\\TbeAffiliatesServiceProvider"
            ]
        }
    }
}
